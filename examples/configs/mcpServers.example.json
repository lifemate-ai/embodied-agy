{
  "mcpServers": {
    "sociality": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/path/to/embodied-agy",
        "--package",
        "sociality-mcp",
        "sociality-mcp"
      ],
      "env": {
        "SOCIAL_POLICY_PATH": "/path/to/embodied-agy/socialPolicy.toml"
      }
    }
  }
}
